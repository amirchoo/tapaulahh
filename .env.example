# Copy to .env.local and fill in.

# Public site URL (used for metadata, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: dashboard → Tapaulahh project → Project Settings → API Keys
# (separate project from Bolahh, same Team Bolahh organisation)
NEXT_PUBLIC_SUPABASE_URL=https://duteuggmjqbselwotfqf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only, bypasses RLS. Needed for npm run test:db and admin work. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
